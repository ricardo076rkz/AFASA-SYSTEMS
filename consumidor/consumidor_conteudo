<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📚 Conteúdo do Curso - AFASA SYSTEMS</title>
        <!-- Carrega o CSS consolidado (main.css), que por sua vez importa base/ + components/ + o CSS específico deste perfil -->
<link rel="stylesheet" href="../css/principal.css">
</head>
<body data-tela="conteudo">
<div class="header">
        <div class="header-content container">
            <a href="course.html" id="voltar-curso" class="back-btn">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                Voltar
            </a>
            <a href="home.html" class="header-logo">
                <img class="logo" src="../imagens/logo.png" alt="Logo">
            </a>
        </div>
    </div>
    

    <div class="container">
        <div style="padding: 24px 20px 100px;">
            <h1 style="font-size: 26px; margin-bottom: 4px;">📚 Conteúdo do Curso</h1>
            <p id="nome-curso" style="color: var(--gray-light); margin-bottom: 20px;"></p>
            <div id="msg" role="status" style="display:none;"></div>

            <section id="secao-lista">
                <button id="btn-novo" type="button" class="btn btn-primary" style="margin-bottom: 16px;" hidden>➕ ADICIONAR AULA</button>
                <div class="course-grid" id="aulas-container"></div>
            </section>

            <section id="secao-form" hidden>
                <h2 id="form-titulo" style="font-size: 22px; margin-bottom: 16px;"></h2>
                <form id="form">
<div class="form-group">
<label for="f-nome">Nome da aula (máx. 150 caracteres)</label><input type="text" id="f-nome" maxlength="150" required>
</div><div class="form-group">
<label for="f-minutos">Duração (minutos, de 1 a 600)</label><input type="number" id="f-minutos" min="1" max="600" step="1" required>
</div><div class="form-group">
<label for="f-descricao">Descrição</label><textarea id="f-descricao" rows="4" maxlength="2000"></textarea>
</div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 24px;">
                        <button type="button" class="btn" data-voltar-lista>← CANCELAR</button>
                        <button type="submit" id="btn-salvar" class="btn btn-primary"></button>
                    </div>
                </form>
            </section>

            <section id="secao-detalhe" hidden>
                <button type="button" class="btn-secundario" data-voltar-lista style="margin-bottom: 16px;">← Voltar à lista</button>
                <div id="detalhe-corpo"></div>
            </section>
        </div>
    </div>

        <!-- Barra de navegação inferior fixa, presente em todas as telas do perfil Consumidor -->
<div class="bottom-nav">
        <a href="home.html" class="nav-item">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
