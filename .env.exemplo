# COPIE este arquivo para ".env" (na raiz, junto do server.js).
# Troque tudo que está entre { } pelos SEUS dados e REMOVA as chaves { }.

DATABASE_URL=postgresql://{SEU_USUARIO}:{SUA_SENHA}@{SEU_HOST}:{SUA_PORTA}/{NOME_DO_BANCO_COMO_ESTA_NO_PGADMIN}
# Exemplo pronto: postgresql://postgres:minhasenha@localhost:5432/afasa_db
# SEU_HOST precisa ser localhost (ou 127.0.0.1). Senha com @ : / # % -> @=%40 :=%3A /=%2F #=%23 %=%25

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

PORT=3000

# --- COMO ERA ANTES (só para comparar, APAGUE do seu .env) ---
# DB_USER=      -> agora é o {SEU_USUARIO}
# DB_PASSWORD=  -> agora é a {SUA_SENHA}
# DB_HOST=localhost -> agora é o {SEU_HOST}
# DB_PORT=5432  -> agora é a {SUA_PORTA}
# DB_NAME=      -> agora é o {NOME_DO_BANCO_COMO_ESTA_NO_PGADMIN}
# JWT_SECRET e PORT continuam iguais.

# PRODUÇÃO (Render): as variáveis ficam só no painel do Render, nunca aqui.